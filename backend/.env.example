# ============================================================
# DevBoard Backend — variabili d'ambiente
# Copia questo file in .env e compila i valori reali
# ============================================================

# Porta del server HTTP
PORT=4000

# Origini consentite al CORS (frontend) — lista separata da virgole.
# In produzione indica il dominio Vercel, es.:
# CLIENT_ORIGIN=https://il-mio-progetto.vercel.app,http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# SameSite del cookie di refresh: 'lax' (default in dev) oppure 'none' (richiesto
# quando frontend e backend sono su domini diversi, es. Vercel + Render).
# In produzione (NODE_ENV=production) il default è già 'none' → non serve impostarla.
# COOKIE_SAMESITE=none

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=devboard

# --- JWT ---
# Segreto access token (scadenza 15 minuti)
JWT_SECRET=change-me-access-secret-in-production
# Segreto refresh token (scadenza 7 giorni)
JWT_REFRESH_SECRET=change-me-refresh-secret-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Nome del cookie che contiene il refresh token (httpOnly)
REFRESH_COOKIE_NAME=devboard_refresh

# Numero massimo di connessioni nel pool MySQL
DB_POOL_LIMIT=10
