# ============================================================
# DevBoard Frontend — variabili d'ambiente (Vite)
# Copia questo file in .env e compila i valori reali
# NOTA: in Vercel vanno impostate come "Environment Variables"
# del progetto PRIMA del build: Vite le inietta a compile time,
# quindi un cambiamento richiede un nuovo deploy.
# ============================================================

# URL base dell'API backend (Express) — in prod: https://tuo-backend.onrender.com
VITE_API_URL=http://localhost:4000

# URL del server Socket.io (stesso host del backend)
VITE_SOCKET_URL=http://localhost:4000
